{
  "name": "molecullage-studio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Molecullage Studio: one world per job, with camera paths, lenses, a live deck and MP4 export.",
  "scripts": {
    "test": "node --test core/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --port 4380 --host 127.0.0.1",
    "export": "node tools/export.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
